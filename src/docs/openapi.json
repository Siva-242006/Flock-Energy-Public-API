{
  "openapi": "3.1.0",
  "info": {
    "title": "Urja Meter Ops API Wrapper",
    "version": "1.0.0",
    "description": "Enterprise REST API wrapper around the Urja Meter Ops legacy application, providing normalized access, robust authentication, and stable OpenAPI contracts."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Application & Legacy System Health Check",
        "description": "Performs a lightweight probe check against the wrapper service and legacy host connectivity.",
        "responses": {
          "200": {
            "description": "Health status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicHealthDTO"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters": {
      "get": {
        "summary": "Search & List Smart Meters",
        "description": "Queries smart meter catalog with pagination support.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search query string",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (defaults to 1)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of smart meters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedMetersResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters/{meterId}": {
      "get": {
        "summary": "Get Smart Meter Details & Network Hierarchy",
        "description": "Combines SvelteKit hydration metadata and geo-location coordinates concurrently into a single domain representation.",
        "parameters": [
          {
            "name": "meterId",
            "in": "path",
            "required": true,
            "description": "Unique meter identifier (e.g. J100000)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Smart meter details and network hierarchy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterDetailResponse"
                }
              }
            }
          },
          "404": {
            "description": "Meter not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters/{meterId}/energy": {
      "get": {
        "summary": "Get Meter Energy Telemetry Log History",
        "description": "Retrieves half-hourly consumption telemetry with ISO-8601 timestamps and numeric values.",
        "parameters": [
          {
            "name": "meterId",
            "in": "path",
            "required": true,
            "description": "Unique meter identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Meter telemetry consumption log history",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnergyDataResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/dts": {
      "get": {
        "summary": "List Distribution Transformers",
        "description": "Retrieves paginated Distribution Transformers dataset.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated Distribution Transformers list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedDTsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/export": {
      "get": {
        "summary": "Export Bulk Dataset",
        "description": "Retrieves normalized bulk export dataset.",
        "responses": {
          "200": {
            "description": "Export dataset",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PublicHealthDTO": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "UP" },
          "legacy": { "type": "string", "example": "CONNECTED" },
          "version": { "type": "string", "example": "1.0.0" },
          "uptime": { "type": "string", "example": "12.45s" },
          "timestamp": { "type": "string", "example": "2026-07-24T10:45:17.000Z" }
        }
      },
      "StandardErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "message": { "type": "string", "example": "Invalid request parameters" },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "example": "INVALID_PARAMETERS" }
            }
          }
        }
      },
      "PaginatedMetersResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "Meters retrieved successfully" },
          "data": {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/PublicMeterSummaryDTO" }
              }
            }
          },
          "pagination": {
            "type": "object",
            "properties": {
              "page": { "type": "integer", "example": 1 },
              "pageSize": { "type": "integer", "example": 20 },
              "total": { "type": "integer", "example": 403 }
            }
          }
        }
      },
      "PublicMeterSummaryDTO": {
        "type": "object",
        "properties": {
          "meterId": { "type": "string", "example": "J100000" },
          "serialNumber": { "type": "string", "example": "SE33962" },
          "make": { "type": "string", "example": "HPL" },
          "phase": { "type": "string", "example": "single" },
          "installationStatus": { "type": "string", "example": "Decommissioned" },
          "dtCode": { "type": "string", "example": "DT-001" }
        }
      },
      "MeterDetailResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "Meter details retrieved successfully" },
          "data": { "$ref": "#/components/schemas/PublicMeterDetailDTO" }
        }
      },
      "PublicMeterDetailDTO": {
        "type": "object",
        "properties": {
          "meterId": { "type": "string", "example": "J100000" },
          "serialNumber": { "type": "string", "example": "SE33962" },
          "make": { "type": "string", "example": "HPL" },
          "phase": { "type": "string", "example": "single" },
          "installationStatus": { "type": "string", "example": "Decommissioned" },
          "installationType": { "type": "string", "example": "Whole Current" },
          "location": {
            "type": "object",
            "properties": {
              "latitude": { "type": "number", "example": 26.93896 },
              "longitude": { "type": "number", "example": 75.83095 }
            }
          },
          "hierarchy": {
            "type": "object",
            "properties": {
              "zone": { "type": "string", "example": "Jaipur Zone 1" },
              "circle": { "type": "string", "example": "Circle 1" },
              "division": { "type": "string", "example": "Division 1" },
              "subdivision": { "type": "string", "example": "Subdivision 1" },
              "subStation": { "type": "string", "example": "Substation 1" },
              "feeder": { "type": "string", "example": "Feeder 1" },
              "dt": { "type": "string", "example": "Malviya Nagar DT 1 (DT-001)" }
            }
          }
        }
      },
      "EnergyDataResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "Meter energy records retrieved successfully" },
          "data": {
            "type": "object",
            "properties": {
              "meterId": { "type": "string", "example": "J100000" },
              "records": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "timestamp": { "type": "string", "example": "2026-06-23T23:30:00" },
                    "kWh": { "type": "number", "example": 48438.74 },
                    "kVAh": { "type": "number", "example": 52313.84 },
                    "voltage": { "type": "number", "example": 226 }
                  }
                }
              }
            }
          }
        }
      },
      "PaginatedDTsResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "Distribution Transformers retrieved successfully" },
          "data": {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "string", "example": "DT-001" },
                    "name": { "type": "string", "example": "Malviya Nagar DT 1" },
                    "feederCode": { "type": "string", "example": "F-001" },
                    "capacityKva": { "type": "number", "example": 100 }
                  }
                }
              }
            }
          },
          "pagination": {
            "type": "object",
            "properties": {
              "page": { "type": "integer", "example": 1 },
              "pageSize": { "type": "integer", "example": 20 },
              "total": { "type": "integer", "example": 40 }
            }
          }
        }
      }
    }
  }
}
